# PostgreSQL (Neon) — string de conexão com pooling
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

APP_TIMEZONE=America/Sao_Paulo

# Cloudflare R2 (Fase 3+: escudos, fotos, anexos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Realtime gerenciado (Fase 5)
ABLY_API_KEY=


